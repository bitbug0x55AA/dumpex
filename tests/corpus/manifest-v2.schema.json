{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitbug0x55AA/dumpex/tests/corpus/manifest-v2.schema.json",
  "title": "dumpex private corpus manifest v2",
  "type": "object",
  "required": ["version", "kind", "policy", "samples"],
  "properties": {
    "version": {
      "const": 2
    },
    "kind": {
      "enum": ["clean", "evil"]
    },
    "policy": {
      "type": "object"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clean"
          }
        }
      },
      "then": {
        "properties": {
          "policy": {
            "type": "object",
            "required": ["false_positive"],
            "properties": {
              "false_positive": {
                "type": "object",
                "required": ["max_detected_hunts"],
                "properties": {
                  "max_detected_hunts": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "policy": {
            "type": "object",
            "required": ["false_negative"],
            "properties": {
              "false_negative": {
                "type": "object",
                "required": ["require_ground_truth_detection"],
                "properties": {
                  "require_ground_truth_detection": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hunter": {
      "enum": [
        "injection",
        "hollowing",
        "stomping",
        "pipe",
        "cs-beacon",
        "yara",
        "obfuscation"
      ]
    },
    "targetedRescanAssertion": {
      "description": "Replays the recovery workflow a targeted rescan exists for: a full-scope hunt leaves an oversized target in the investigation queue, the queue recommends a hunter-specific rescan, and that rescan is run over exactly that target. The rescan target is read off the queue, never pinned here. The assertion is about the rescan being ACTIONABLE and scope-honest, not about a verdict -- a rescan that finds nothing is a valid outcome, one that explains nothing is not. Omit the whole object for a sample whose hunt leaves no oversized queue entry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hunter"],
      "properties": {
        "hunter": {
          "$ref": "#/$defs/hunter"
        },
        "coverage_status": {
          "enum": ["complete", "partial", "not_evaluated"]
        },
        "require_measurements": {
          "description": "Measurement names every closure that reached the bytes must retain. A closure that completed without a hit and recorded nothing is the under-informative result this replay exists to catch. Defaults to bytes_evaluated.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_measurements": {
          "description": "Minimum numeric measurement values required from named targeted scopes. Use this to pin a real-sample observation (for example entropy.entropy_windows_above_threshold: 1), not merely the presence of its field.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "minLength": 1
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "require_applicability_reasons": {
          "description": "When true (the default), every closure reporting coverage_status \"not_applicable\" must name the eligibility gate that declined the target, and no other closure may name one.",
          "type": "boolean"
        }
      }
    },
    "huntAssertion": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "DETECTED",
            "NOT_DETECTED_IN_SCANNED_SCOPE",
            "INCONCLUSIVE",
            "NOT_EVALUATED"
          ]
        },
        "coverage_status": {
          "enum": ["complete", "partial", "not_evaluated"]
        },
        "min_score": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "id",
        "file",
        "sha256",
        "category",
        "source",
        "authorization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^samples[/\\\\]"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "type": "object"
        },
        "ground_truth": {
          "type": "object",
          "required": ["detected_hunts", "basis"],
          "properties": {
            "detected_hunts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/hunter"
              }
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected": {
          "type": "object",
          "properties": {
            "hunt": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/hunter"
              },
              "additionalProperties": {
                "$ref": "#/$defs/huntAssertion"
              }
            },
            "targeted_rescan": {
              "$ref": "#/$defs/targetedRescanAssertion"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
